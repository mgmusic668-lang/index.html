<!DOCYTYPE html>
<html lang="pt-br">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Download Key - PC</title>
    <style>
        * {
            margin: 0;
            padding: 0;
            box-sizing: border-box;
            font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
        }

        body {
            height: 100vh;
            display: flex;
            justify-content: center;
            align-items: center;
            background: linear-gradient(180deg, #0099ff 0%, #0066ff 100%);
            padding: 20px;
        }

        .card {
            background-color: #052c65;
            width: 100%;
            max-width: 450px;
            border-radius: 15px;
            padding: 40px 20px;
            text-align: center;
            color: white;
            box-shadow: 0 10px 30px rgba(0,0,0,0.3);
        }

        h1 {
            font-size: 28px;
            margin-bottom: 10px;
            font-weight: bold;
        }

        p.subtitle {
            font-size: 14px;
            color: #cbd5e0;
            margin-bottom: 30px;
            line-height: 1.4;
        }

        .key-container {
            background-color: rgba(255, 255, 255, 0.1);
            border: 1px solid rgba(255, 255, 255, 0.2);
            border-radius: 8px;
            padding: 20px;
            margin-bottom: 20px;
            word-break: break-all;
            font-family: monospace;
            font-size: 18px;
            letter-spacing: 2px;
        }

        .copy-btn {
            background-color: white;
            color: #0066ff;
            border: none;
            padding: 12px 35px;
            border-radius: 8px;
            font-weight: bold;
            font-size: 16px;
            cursor: pointer;
            transition: transform 0.2s;
            margin-bottom: 30px;
        }

        .copy-btn:active {
            transform: scale(0.95);
        }

        .instructions {
            text-align: left;
            display: inline-block;
            font-size: 13px;
            color: #cbd5e0;
            line-height: 1.8;
        }

        .instructions span {
            display: block;
        }

        strong {
            color: white;
        }
    </style>
</head>
<body>

    <div class="card">
        <h1>Your PC Download Key</h1>
        <p class="subtitle">Copy the key below and paste it in the <strong>/download</strong> command on Discord.</p>

        <div class="key-container" id="keyDisplay">
            </div>

        <button class="copy-btn" onclick="copyKey()">Copy Key</button>

        <div class="instructions">
            <span>1. Copy the key above</span>
            <span>2. Go to the StumbleCups Discord server</span>
            <span>3. Use the <strong>/download</strong> command</span>
            <span>4. Paste your key when prompted</span>
        </div>
    </div>

    <script>
        // Função para gerar uma chave aleatória (UUID v4 style)
        function generateKey() {
            const pattern = 'xxxxxxxx-xxxx-4xxx-yxxx-xxxxxxxxxxxx';
            return pattern.replace(/[xy]/g, function(c) {
                var r = Math.random() * 16 | 0, 
                    v = c == 'x' ? r : (r & 0x3 | 0x8);
                return v.toString(16);
            });
        }

        // Coloca a chave na tela assim que carrega
        const keyElement = document.getElementById('keyDisplay');
        const currentKey = generateKey();
        keyElement.innerText = currentKey;

        // Função do botão de copiar
        function copyKey() {
            navigator.clipboard.writeText(keyElement.innerText).then(() => {
                const btn = document.querySelector('.copy-btn');
                btn.innerText = "Copied!";
                setTimeout(() => btn.innerText = "Copy Key", 2000);
            });
        }
    </script>
</body>
</html>
